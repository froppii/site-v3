---
import Header from "../components/Header.astro";
import "../styles/global.css";

const {title} = Astro.props;
---

<html lang="en">
    <head>
        <title>{title}</title>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device width" />
    </head>
    <body>
        <Header />
        <main class="container">
            <slot />
        </main>
        <footer>
            <slot name="footer" />
        </footer>
    </body>
</html>

<script>
    window.addEventListener("mousemove", (event) => {
        const xPercent = (event.clientX / window.innerWidth - 0.5) * 40
        const yPercent = (event.clientY / window.innerHeight - 0.5) * 40

        document.body.style.setProperty("--mouse-x", `${xPercent}px`);
        document.body.style.setProperty("--mouse-y", `${yPercent}px`);
    });
</script>

<style>
    .container {
        max-width: 700px;
        margin: 0 auto;
        padding: 1.5rem;
    }
</style>