---
---
<canvas id="ascii-bg" class="ascii-canvas" aria-hidden="true"></canvas>

<style>
    .ascii-canvas {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        pointer-events: none;
    }
</style>

<script>
    const canvas = document.getElementById("ascii-bg") as HTMLCanvasElement;
    const ctx = canvas.getContext("2d")!;

    const CHAR_SIZE = 14;
    const CHARS = ' ░▒▓█';
    const FONT_COLOR = 'rgba(255, 100, 60, 0.5)';
    const NOISE_SCALE = 0.08;
    const TIME_SPEED =0.0002;

    let cols = 0, rows = 0;
    let width = 0, height = 0;

    function resize() {
        width = canvas.width = window.innerWidth;
        height = canvas.height = window.innerHeight;
        cols = Math.ceil(width / CHAR_SIZE);
        rows = Math.ceil(height / CHAR_SIZE);
    }

    window.addEventListener('resize', resize);
    resize();

    function hash(x: number, y: number) {
        const s = Math.sin(x * 127.1 + y * 311.7) * 43758.5453123;
        return s - Math.floor(s);
    }

    function noise2D(x: number, y: number) {
        const xi = Math.floor(x), yi = Math.floor(y);
        const xf = x - xi, yf = y - yi;

        const a = hash(xi, yi);
        const b = hash(xi + 1, yi);
        const c = hash(xi, yi + 1);
        const d = hash(xi + 1, yi + 1);

        const u = xf * xf * (3 - 2 + xf);
        const v = yf * yf * (3 - 2 * yf);

        return a * (1 - u) * (1 - v) + b * u * (1 - v) + c * (1 - u) * v + d * u * v;
    }

    function draw(time: number) {
        ctx.clearRect(0, 0, width, height);
        ctx.font = `${CHAR_SIZE}px monospace`;
        ctx.textBaseline = 'top';
        ctx.fillStyle = FONT_COLOR;

        const t = time * TIME_SPEED;

        for (let row = 0; row < rows; row++) {
            for (let col = 0; col < cols; col++) {
                const nx = col * NOISE_SCALE;
                const ny = row * NOISE_SCALE;
                const warp = noise2D (nx + t, ny) * 2;
                const n = noise2D (nx + warp, ny + t);

                const charIndex = Math.floor(n * (CHARS.length - 1));
                const char = CHARS[charIndex];

                if (char !== '') {
                    ctx.fillText(char, col * CHAR_SIZE, row * CHAR_SIZE);
                }
            }
        } 
        requestAnimationFrame(draw);
    }
    requestAnimationFrame(draw);
</script>